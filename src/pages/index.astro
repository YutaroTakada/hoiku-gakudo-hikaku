---
import Base from "../layouts/Base.astro";
import { facilities } from "../lib/data";
import { href } from "../lib/format";
import { AREAS, CATEGORIES, SITE } from "../config/site";

const n = (cat: string, area?: string) => facilities.filter((f) => f.category === cat && (!area || f.ward === area)).length;
---
<Base>
  <h1>{SITE.name}</h1>
  <p class="lead">区の公式情報から、時間・料金・空きを並べて比べられます。</p>

  <div class="entries">
    {CATEGORIES.map((c) => (
      <section class="entry panel" aria-labelledby={`h-${c.id}`}>
        <a class="entry-main" href={href(`/${c.id}/`)}>
          <h2 id={`h-${c.id}`}>{c.label}</h2>
          <span class="sub num">{n(c.id)}施設</span>
        </a>
        {AREAS.length > 1 && (
          <ul class="areas">
            {AREAS.filter((a) => n(c.id, a.id) > 0).map((a) => (
              <li><a class="btn" href={href(`/${c.id}/?area=${a.id}`)}>{a.name}<span class="sub num" style="font-weight:400">{n(c.id, a.id)}</span></a></li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>

  <ul class="rules sub">
    <li>値はすべて出どころと確認日つき</li>
    <li>分からない値は「—」（未確認）。推測で埋めません</li>
    <li>口コミ・評価・ランキングはありません</li>
  </ul>
</Base>
