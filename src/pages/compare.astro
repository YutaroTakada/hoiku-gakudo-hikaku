---
import Base from "../layouts/Base.astro";
import { href } from "../lib/format";
import { CATEGORIES, SITE } from "../config/site";
---
<Base title="比較" current="compare">
  <h1>比較</h1>
  <div id="cmp" data-base={href("")}>
    <div class="cmp-tools" id="cmp-tools" hidden>
      <p class="sub"><span class="num" id="cmp-n">0</span> / {SITE.maxCompare}件</p>
      <div class="acts" style="margin:0">
        <label class="chip"><input type="checkbox" id="diff" /><span>違う項目だけ</span></label>
        <button type="button" class="btn ghost" id="clear">すべて外す</button>
      </div>
    </div>
    <div class="empty panel" id="cmp-empty" hidden style="margin-top:16px">
      <h2 class="sub" style="font-size:16px;color:var(--color-text-primary)">比較に入れた施設はありません</h2>
      <p class="sub">一覧の「比較」で{SITE.maxCompare}件まで入れられます。</p>
      <div class="acts" style="margin:0">
        {CATEGORIES.map((c) => <a class="btn" href={href(`/${c.id}/`)}>{c.label}の一覧</a>)}
      </div>
    </div>
  </div>
  <script>
    import { load, save, onChange } from "../scripts/compare-store";
    type Row = { group: string; label: string; text: string | null; source: string | null; sourceLabel: string | null; checked: string | null; note?: string; stale: boolean; link?: string };
    type D = { id: string; name: string; ward: string; type: string; management: string; rows: Row[] };

    const root = document.getElementById("cmp")!;
    const base = root.dataset.base!.replace(/\/$/, "");
    const diff = document.getElementById("diff") as HTMLInputElement;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const sd = (iso: string | null) => (iso ? iso.replaceAll("-", "/") : "");
    const cache = new Map<string, D | null>();

    // ?ids= があればそれを比較に入れる（共有された URL から開いたとき）
    const qs = new URLSearchParams(location.search).get("ids");
    if (qs !== null) save(qs.split(",").filter((x) => /^[a-z0-9_-]+$/.test(x)));
    diff.checked = new URLSearchParams(location.search).get("diff") === "1";

    async function get(id: string): Promise<D | null> {
      if (!cache.has(id)) cache.set(id, await fetch(`${base}/data/${id}.json`).then((r) => (r.ok ? r.json() : null)).catch(() => null));
      return cache.get(id)!;
    }

    let drawing = 0;
    async function draw() {
      const my = ++drawing;
      const ids = load();
      const p = new URLSearchParams();
      if (ids.length) p.set("ids", ids.join(","));
      if (diff.checked) p.set("diff", "1");
      history.replaceState(history.state, "", location.pathname + (p.size ? "?" + p.toString().replaceAll("%2C", ",") : ""));
      const list = (await Promise.all(ids.map(get))).filter(Boolean) as D[];
      if (my !== drawing) return;
      root.querySelector(".cmp-scroll")?.remove();
      document.getElementById("cmp-empty")!.hidden = list.length > 0;
      document.getElementById("cmp-tools")!.hidden = list.length === 0;
      document.getElementById("cmp-n")!.textContent = String(list.length);
      if (!list.length) return;
      const labels: { group: string; label: string }[] = [];
      for (const d of list) for (const r of d.rows) if (!labels.some((l) => l.group === r.group && l.label === r.label)) labels.push({ group: r.group, label: r.label });
      let html = `<div class="cmp-scroll panel"><table class="cmp"><thead><tr><th scope="col"><span class="vh">項目</span></th>`;
      for (const d of list) html += `<th scope="col"><a href="${base}/f/${d.id}/">${esc(d.name)}</a><div class="cap">${esc(d.ward)}・${esc(d.type)}・${esc(d.management)}</div><button type="button" class="btn rm" data-rm="${d.id}" aria-label="${esc(d.name)}を比較から外す">外す</button></th>`;
      html += `</tr></thead><tbody>`;
      let g = "";
      for (const l of labels) {
        const cells = list.map((d) => d.rows.find((x) => x.group === l.group && x.label === l.label));
        const same = list.length > 1 && cells.every((r) => (r?.text ?? null) === (cells[0]?.text ?? null));
        if (diff.checked && same) continue;
        if (l.group !== g) { g = l.group; html += `<tr class="grp"><th scope="rowgroup" colspan="${list.length + 1}">${esc(g)}</th></tr>`; }
        html += `<tr${same ? ' class="same"' : ""}><th scope="row">${esc(l.label)}</th>`;
        for (const r of cells) {
          if (!r || r.text === null) { html += `<td><span class="na">—</span> <span class="cap">未確認</span></td>`; continue; }
          const v = r.link ? `<a href="${esc(r.link)}" rel="noopener">${esc(r.text)}</a>` : esc(r.text);
          const src = r.source ? `<span class="src"><a href="${esc(r.source)}" rel="noopener">${esc(r.sourceLabel ?? "出どころ")}</a>・${sd(r.checked)}確認${r.stale ? '<span class="old">・古い可能性あり</span>' : ""}</span>` : "";
          html += `<td>${v}${src}</td>`;
        }
        html += `</tr>`;
      }
      html += `</tbody></table></div>`;
      root.insertAdjacentHTML("beforeend", html);
    }
    root.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("[data-rm]");
      if (b) save(load().filter((x) => x !== b.dataset.rm));
    });
    document.getElementById("clear")!.addEventListener("click", () => save([]));
    diff.addEventListener("change", draw);
    onChange(draw);
    draw();
  </script>
</Base>
