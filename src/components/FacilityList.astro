---
import { facilities } from "../lib/data";
import { areaName, category, typeLabel } from "../config/site";
import { FILTERS, summaryFor, labelFor } from "../config/fields";
import { href, isStale, shortAddress, vacancyAgesAttr } from "../lib/format";
import { API } from "../lib/agent-data";
import FacilityImage from "./FacilityImage.astro";
import MapCredits from "./MapCredits.astro";
import Icon from "./Icon.astro";
import AddButton from "./AddButton.astro";

interface Props { category: string; area: string }
const { category: cat, area } = Astro.props;
const c = category(cat);
const list = facilities.filter((f) => f.category === cat && f.ward === area).sort((a, b) => a.name.localeCompare(b.name, "ja"));
const summary = summaryFor(cat);


// 絞り込み：この一覧に該当がある選択肢だけ出す
const filters = FILTERS.flatMap((d) => {
  if (d.kind === "one" || d.kind === "many") {
    const have = new Set(list.map(d.attr));
    const options = d.options(cat).filter((o) => have.has(o.value));
    if (options.length < 2) return [];
    return [{ ...d, label: labelFor(d.label, cat), options }];
  }
  if (d.kind === "flag") return list.some(d.test) ? [{ ...d }] : [];
  return [{ ...d, label: labelFor(d.label, cat) }];
});
const flags = filters.filter((d) => d.kind === "flag") as Extract<(typeof FILTERS)[number], { kind: "flag" }>[];
const sorts = summary.filter((s) => s.sort);
// 並べ替えの幅：いちばん長い選択肢の文字数（全角1字≒1em）＋左の余白・右の矢印の場所・枠
const sortChars = Math.max("名前順".length, ...sorts.map((s) => labelFor(s.sort!.label, cat).length));

// 画面の JS に渡す設定（並べ替えの向き・絞り込みの種類・表示名）
const cfg = {
  unit: c.ageUnit,
  short: c.ageShort,
  sorts: Object.fromEntries(sorts.map((s) => [s.key, s.sort!.dir])),
  filters: filters.map((d) => ({
    key: d.key,
    kind: d.kind,
    label: "label" in d ? String(d.label) : "",
    byAge: d.kind === "flag" ? !!d.byAge : undefined,
    options: "options" in d ? Object.fromEntries(d.options.map((o) => [o.value, o.label])) : undefined,
  })),
};
const na = '<span class="na">—<span class="vh">未確認</span></span>';
---
<h1 class="vh">{areaName(area)}の{c.label}</h1>

<form class="search" role="search" onsubmit="return false" autocomplete="off">
  <Icon name="search" />
  <label class="vh" for="q">施設名・住所で探す</label>
  <input class="input" type="search" id="q" name="q" placeholder="施設名・町名" enterkeyhint="search" />
</form>

<div class="list-layout">
  <dialog class="sheet" id="filters" aria-labelledby="filters-h">
    <div class="sheet-hd">
      <h2 id="filters-h" class="sub" style="font-weight:600;color:var(--color-text-primary)">絞り込み</h2>
      <button type="button" class="btn ghost close" data-close aria-label="閉じる"><Icon name="close" /></button>
    </div>
    <form id="f" class="sheet-body" onsubmit="return false" autocomplete="off">
      {filters.filter((d) => d.kind === "one" || d.kind === "age").map((d) => (
        <fieldset>
          <legend>{"label" in d && d.label}</legend>
          {d.kind === "one" && (
            <div class="chips">
              <label class="chip"><input type="radio" name={d.key} value="" checked /><span>すべて</span></label>
              {d.options.map((o) => <label class="chip"><input type="radio" name={d.key} value={o.value} /><span>{o.label}</span></label>)}
            </div>
          )}
          {d.kind === "age" && (
            <div class="chips">
              <label class="chip"><input type="radio" name="age" value="" checked /><span>指定なし</span></label>
              {c.ages.map((a) => <label class="chip"><input type="radio" name="age" value={a} /><span>{a}{c.ageUnit}</span></label>)}
            </div>
          )}
          {d.kind === "many" && (
            <div class="checks">
              {d.options.map((o) => <label><input type="checkbox" name={d.key} value={o.value} checked />{o.label}</label>)}
            </div>
          )}
        </fieldset>
      ))}
      {flags.length > 0 && (
        <fieldset>
          <legend>条件</legend>
          <div class="chips">
            {flags.map((d) => <label class="chip"><input type="checkbox" name={d.key} value="1" /><span>{d.label}</span></label>)}
          </div>
        </fieldset>
      )}
      {filters.filter((d) => d.kind === "many").map((d) => (
        <fieldset>
          <legend>{"label" in d && d.label}</legend>
          {d.kind === "one" && (
            <div class="chips">
              <label class="chip"><input type="radio" name={d.key} value="" checked /><span>すべて</span></label>
              {d.options.map((o) => <label class="chip"><input type="radio" name={d.key} value={o.value} /><span>{o.label}</span></label>)}
            </div>
          )}
          {d.kind === "age" && (
            <div class="chips">
              <label class="chip"><input type="radio" name="age" value="" checked /><span>指定なし</span></label>
              {c.ages.map((a) => <label class="chip"><input type="radio" name="age" value={a} /><span>{a}{c.ageUnit}</span></label>)}
            </div>
          )}
          {d.kind === "many" && (
            <div class="checks">
              {d.options.map((o) => <label><input type="checkbox" name={d.key} value={o.value} checked />{o.label}</label>)}
            </div>
          )}
        </fieldset>
      ))}
    </form>
    <div class="sheet-ft">
      <button type="button" class="btn ghost" data-reset>条件を外す</button>
      <button type="button" class="btn primary" data-close><span class="num" data-n>{list.length}</span>件を表示</button>
    </div>
  </dialog>

  <div>
    <div class="toolbar">
      <p class="total" aria-live="polite"><b class="num" id="count">{list.length}</b>件</p>
      <button type="button" class="btn open-filters" id="open-filters" aria-haspopup="dialog">
        <Icon name="filter" />絞り込み<span class="count-badge num" id="active-n" hidden>0</span>
      </button>
      <label class="vh" for="sort">並べ替え</label>
      <select class="select" id="sort" style={`width: calc(${sortChars}em + 56px)`}>
        <option value="">名前順</option>
        {sorts.map((s) => <option value={s.key}>{labelFor(s.sort!.label, cat)}</option>)}
      </select>
    </div>
    <p class="cap legend">— は未確認。値の出どころは各施設のページに。</p>
    <noscript>
      <p class="cap legend">
        絞り込みには JavaScript が必要です。JavaScript を使わない場合は<a href={href(API.list(area, cat))}>全件のデータ</a>か、{c.ageLabel}別のデータを使えます：
        {c.ages.map((a, i) => <>{i > 0 && "・"}<a href={href(API.age(area, cat, a))}>{a}{c.ageUnit}</a></>)}
      </p>
    </noscript>

    <script is:inline>
      if (location.search) {
        document.documentElement.classList.add("list-pending");
        setTimeout(() => document.documentElement.classList.remove("list-pending"), 5000);
      }
    </script>
    <ul class="items panel" id="items">
      {list.map((f, index) => {
        const r = f.ageRange.value;
        const fl = flags.filter((d) => d.test(f)).map((d) => d.key).join(" ");
        const attrs: Record<string, string> = {
          "data-age": r ? `${r.min}-${r.max}` : "",
          ...(fl ? { "data-flags": fl } : {}),
          ...(vacancyAgesAttr(f) ? { "data-va": vacancyAgesAttr(f) } : {}),
          ...(f.listedName !== f.name ? { "data-alt": f.listedName } : {}),
        };
        for (const d of filters) if (d.kind === "one" || d.kind === "many") attrs[`data-f-${d.key}`] = d.attr(f);
        for (const s of sorts) { const n = s.num!(f); if (n !== null) attrs[`data-s-${s.key}`] = String(n); }
        return (
          <li {...attrs}>
            <a class="image-link" href={href(`/f/${f.id}/`)} tabindex="-1" aria-hidden="true"><FacilityImage facility={f} lazy priority={index === 0} /></a>
            <h3><a href={href(`/f/${f.id}/`)}>{f.name}</a></h3>
            <p class="meta sub">{typeLabel(f.type)}・{f.management}{shortAddress(f) && <>・<span class="addr">{shortAddress(f)}</span></>}</p>
            <AddButton id={f.id} name={f.name} />
            <dl class="stats">
              {summary.map((s) => {
                const t = s.text(f);
                return (
                  <div>
                    <dt data-k={s.key === "vac" ? "vac" : undefined}>{labelFor(s.label, cat)}</dt>
                    <dd data-k={s.key === "vac" ? "vac" : undefined}>{t === null ? <Fragment set:html={na} /> : t}{t !== null && isStale(s.field(f).checked) && <span class="old"> 古い可能性あり</span>}</dd>
                  </div>
                );
              })}
            </dl>
          </li>
        );
      })}
    </ul>
    <script is:inline>
      if (!location.search) {
        document.querySelectorAll("#items img").forEach((img, i) => { if (i < 2) img.loading = "eager"; });
      }
    </script>
    {cat === "gakudo" && list.some((f) => f.image.value) && <MapCredits />}
    <div class="empty panel" id="empty" hidden>
      <h2 class="sub" style="font-size:16px;color:var(--color-text-primary)">条件に合う施設はありません</h2>
      <div class="acts" id="empty-acts"></div>
    </div>
  </div>
</div>

<script type="application/json" id="list-cfg" set:html={JSON.stringify(cfg)} />
<script>
  import "../scripts/list";
</script>
