---
import "../styles/global.css";
import { href } from "../lib/format";
import { CATEGORIES, SITE } from "../config/site";
import { activeAreas } from "../lib/regions";
import { API } from "../lib/agent-data";
import sources from "../../data/sources.json";

interface Props { title?: string; description?: string; current?: string; area?: string; canonical?: string; refresh?: string; /** ページ内にカテゴリのタブがあるときはナビに重ねて出さない */ localTabs?: boolean; /** このページの内容を機械向けに読める JSON */ dataPath?: string }
const { dataPath = API.index, localTabs = false, title, description = `${activeAreas.map((a) => a.name).join("・")}の保育園・学童を、自治体の公式情報で比べるサイト。`, current, area, canonical, refresh } = Astro.props;
const fullTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}（${activeAreas.map((a) => a.name).join("・")}）`;
const selectedArea = activeAreas.find((a) => a.id === area);
const nav = [...CATEGORIES.filter((c) => !localTabs && selectedArea?.categories.some((x) => x.id === c.id)).map((c) => ({ key: c.id, label: c.label, path: `/a/${selectedArea!.id}/${c.id}/` })), { key: "compare", label: "比較", path: "/compare/" }];
const [y, m, d] = sources.collectedAt.split("-").map(Number);
---
<!doctype html>
<html lang="ja" data-max-compare={SITE.maxCompare}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(canonical ?? Astro.url.pathname, Astro.site)} />
    {refresh && <meta http-equiv="refresh" content={`2;url=${refresh}`} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/json" href={href(dataPath)} title="機械向けデータ（JSON）" />
    <link rel="sitemap" type="application/xml" href={href("/sitemap.xml")} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">本文へ</a>
    <header class="hd">
      <div class="wrap">
        <a class="brand" href={href("/")}>{SITE.name}</a>
        <nav class="nav" aria-label="サイト内">
          {nav.map((n) => (
            <a href={href(n.path)} aria-current={current === n.key ? "page" : undefined}>
              {n.label}{n.key === "compare" && <span class="count-badge num" data-cmp-count hidden>0</span>}
            </a>
          ))}
        </nav>
        <a class="about-link" href={href("/about/")} aria-current={current === "about" ? "page" : undefined}>このサイトについて</a>
      </div>
    </header>
    <main id="main">
      <div class="wrap"><slot /></div>
    </main>
    <footer class="ft">
      <div class="wrap cap">
        <p>自治体の公式情報から作成（最終取得 {y}年{m}月{d}日）。申込の前に自治体と施設に確認してください。</p>
        <p><a href={href("/about/")}>集め方と方針</a> ・ <a href={href(API.guide)}>AIエージェントで使う</a> ・ <a href={SITE.repo}>ソースとデータ</a></p>
      </div>
    </footer>
    {current !== "compare" && (
      <div class="cmpbar" id="cmpbar" hidden>
        <div class="wrap">
          <p class="sub">比較に <b class="num" data-bar-n>0</b> / {SITE.maxCompare}件</p>
          <a class="btn primary" data-bar-go data-base={href("/compare/")} href={href("/compare/")}>比べる</a>
        </div>
      </div>
    )}
    <script>
      import "../scripts/compare-store";
    </script>
  </body>
</html>
