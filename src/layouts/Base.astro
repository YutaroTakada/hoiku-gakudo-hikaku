---
import "../styles/global.css";
import { href } from "../lib/format";
import { AREA_LIST, CATEGORIES, SITE } from "../config/site";
import sources from "../../data/sources.json";

interface Props { title?: string; description?: string; current?: string }
const { title, description = `${AREA_LIST}の保育園・学童を、区の公式情報で比べるサイト。`, current } = Astro.props;
const fullTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}（${AREA_LIST}）`;
const nav = [...CATEGORIES.map((c) => ({ key: c.id, label: c.label, path: `/${c.id}/` })), { key: "compare", label: "比較", path: "/compare/" }];
const [y, m, d] = sources.collectedAt.split("-").map(Number);
---
<!doctype html>
<html lang="ja" data-max-compare={SITE.maxCompare}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">本文へ</a>
    <header class="hd">
      <div class="wrap">
        <a class="brand" href={href("/")}>{SITE.name}</a>
        <nav class="nav" aria-label="サイト内">
          {nav.map((n) => (
            <a href={href(n.path)} aria-current={current === n.key ? "page" : undefined}>
              {n.label}{n.key === "compare" && <span class="count-badge num" data-cmp-count hidden>0</span>}
            </a>
          ))}
        </nav>
        <a class="about-link" href={href("/about/")} aria-current={current === "about" ? "page" : undefined}>このサイトについて</a>
      </div>
    </header>
    <main id="main">
      <div class="wrap"><slot /></div>
    </main>
    <footer class="ft">
      <div class="wrap cap">
        <p>区の公式情報から作成（最終取得 {y}年{m}月{d}日）。申込の前に区と施設に確認してください。</p>
        <p><a href={href("/about/")}>集め方と方針</a> ・ <a href={SITE.repo}>ソースとデータ</a></p>
      </div>
    </footer>
    {current !== "compare" && (
      <div class="cmpbar" id="cmpbar" hidden>
        <div class="wrap">
          <p class="sub">比較に <b class="num" data-bar-n>0</b> / {SITE.maxCompare}件</p>
          <a class="btn primary" data-bar-go data-base={href("/compare/")} href={href("/compare/")}>比べる</a>
        </div>
      </div>
    )}
    <script>
      import "../scripts/compare-store";
    </script>
  </body>
</html>
